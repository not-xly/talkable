{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talkable",
  "version": "0.2.0",
  "identifier": "app.talkable.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Talkable — local dictation",
        "width": 540,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"],
    "resources": ["../../LICENSE", "../../THIRD_PARTY_LICENSES.md"]
  }
}
